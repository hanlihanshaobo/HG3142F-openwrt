# HG3142F (FiberHome, BCM6855x / bcm96855) — OpenWrt 设备配置片段
# 用法: cp port/configs/mb4784w.config sources/openwrt/.config && make defconfig
#
# 阶段 1 目标：内核能在 115200 串口启动，initramfs 进入 shell。

CONFIG_TARGET_bcmbca=y
CONFIG_TARGET_bcmbca_generic=y
CONFIG_TARGET_bcmbca_generic_DEVICE_fiberhome_mb4784w=y

# 基础系统
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_openssh-sftp-server=n

# 存储 / 闪存工具（NAND + UBI 必备）
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_kmod-mtd-nand=y
CONFIG_PACKAGE_kmod-ubi=y
CONFIG_PACKAGE_kmod-nand=y
CONFIG_PACKAGE_kmod-nand-ecc=y
CONFIG_PACKAGE_kmod-nand-brcmnand=y

# 串口调试
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_picocom=y

# 镜像体积控制
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=96
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
