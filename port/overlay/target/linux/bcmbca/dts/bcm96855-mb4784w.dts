// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * FiberHome HG3142F (Broadcom BCM6855x / bcm96855)
 *
 * 依据实机全量备份（SN 071604000590814）还原：
 *   - SoC: 3 x Cortex-A7, 512MiB DDR
 *   - NAND: 256MiB, brcmnand, 128KiB 擦除块
 *   - 分区表见下方 partitions（与 /proc/mtd 实测一致）
 *
 * 注意：上游 bcm6855.dtsi 里的 NAND 节点标签是 nand_controller / nandcs，
 *      没有 &nand；uart0 默认 disabled，必须显式打开才有控制台。
 */

/dts-v1/;

#include "broadcom/bcm6855.dtsi"

/ {
	model = "FiberHome HG3142F";
	compatible = "fiberhome,mb4784w", "brcm,bcm96855", "brcm,bcm6855", "brcm,bcmbca";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/* 原厂实测控制台就是 ttyAMA0（PL011），不是 ttyS0 */
		/* 前半段与厂商一致；root=/dev/ubiblock0_4 等由 U-Boot 按 img_index 追加 */
		bootargs = "coherent_pool=2M cpuidle_sysfs_switch console=ttyAMA0,115200 earlycon rootwait pci=pcie_bus_safe";
	};

	/* 512 MiB（原厂 U-Boot 打印 "DRAM: 512 MiB"） */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x20000000>;
	};

	/*
	 * PCIe 主机控制器（2 个）
	 * 数据取自实机原厂设备树 orig_968552CREF_CM_XG.dts：
	 *   pcie@0 → domain 1，GIC SPI 43，窗口 0xc0000000（BCM6710 WiFi）
	 *   pcie@1 → domain 2，GIC SPI 44，窗口 0xd0000000（RTL8125 2.5G 网卡）
	 */
	pcie@0 {
		compatible = "brcm,bcm963xx-pcie";
		device_type = "pci";
		reg = <0x80040000 0xa000>;

		#address-cells = <3>;
		#size-cells = <2>;
		ranges = <0x2000000 0x0 0xc0000000 0xc0000000 0x0 0x10000000>;

		interrupt-names = "intr";
		interrupts = <0 43 4>;
		#interrupt-cells = <1>;
		interrupt-map = <0 0 0 0 0x1 0 43 4>;

		brcm,coreid = <0>;
		brcm,apon;	/* 无链路也保持 PCIe 核心供电 */
		linux,pci-domain = <1>;
		status = "okay";
	};

	pcie@1 {
		compatible = "brcm,bcm963xx-pcie";
		device_type = "pci";
		reg = <0x80050000 0xa000>;

		#address-cells = <3>;
		#size-cells = <2>;
		ranges = <0x2000000 0x0 0xd0000000 0xd0000000 0x0 0x10000000>;

		interrupt-names = "intr";
		interrupts = <0 44 4>;
		#interrupt-cells = <1>;
		interrupt-map = <0 0 0 0 0x1 0 44 4>;

		brcm,coreid = <1>;
		brcm,apon;	/* 无链路也保持 PCIe 核心供电 */
		linux,pci-domain = <2>;
		status = "okay";
	};

	/*
	 * bcm_enet：unimac + Runner 交换芯片
	 *
	 * 数据来自实机原厂 DTS（orig_968552CREF_CM_XG.dts）。节点名加 bcm_
	 * 前缀，避免和上游 bcm6855.dtsi 重名；驱动全部按 compatible 查找，
	 * 不依赖节点名。
	 *
	 * switch0 是 dt_parsing.c 的入口：has_dt() 只有在能找到
	 * compatible="brcm,enet" 且至少一个子节点有可用端口时才返回 1。
	 * 没有它，bcm_enet_init() 会走 BP 老路径并因为 root_sw==NULL 崩溃。
	 */
	bcm_unimac: unimac3 {
		compatible = "brcm,unimac3";
		reg = <0x828a8000 0x6000>, <0x828b0000 0x1800>;
		conf_offset = <0x1000>;
		mib_offset = <0x400>;
		top_offset = <0x400>;
	};

	bcm_egphy: egphy {
		compatible = "brcm,egphy";
		reg = <0x828ba204 0xc>;
	};

	bcm_sgmii: sgmii {
		compatible = "brcm,sgmii";
		reg = <0x828ba280 0x14>;
	};

	/* 实机是 brcm,mdio1（0xff802060）；bcm_enet 的 MDIO_V1 总线 */
	bcm_mdio1: mdio1 {
		compatible = "brcm,mdio1";
		reg = <0xff802060 0x10>;
	};

	bcm_mdio: mdio {
		compatible = "simple-bus";
		bus-type = "MDIO_V1";
		#address-cells = <1>;
		#size-cells = <0>;

		/* 4 个 LAN GPHY（原厂 EGPHY，MDIO 地址 1..4） */
		phy_lan0: ethernet-phy@1 {
			compatible = "brcm,bcaphy";
			phy-type = "EGPHY";
			reg = <1>;
			status = "okay";
		};

		phy_lan1: ethernet-phy@2 {
			compatible = "brcm,bcaphy";
			phy-type = "EGPHY";
			reg = <2>;
			status = "okay";
		};

		phy_lan2: ethernet-phy@3 {
			compatible = "brcm,bcaphy";
			phy-type = "EGPHY";
			reg = <3>;
			status = "okay";
		};

		phy_lan3: ethernet-phy@4 {
			compatible = "brcm,bcaphy";
			phy-type = "EGPHY";
			reg = <4>;
			status = "okay";
		};

		/* lan4 走 SGMII（MDIO 地址 6） */
		phy_lan4: ethernet-phy@6 {
			compatible = "brcm,bcaphy";
			phy-type = "SGMII";
			reg = <6>;
			status = "okay";
		};
	};

	switch0 {
		compatible = "brcm,enet";
		label = "bcmsw";
		sw-type = "RUNNER_SW";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				mac-type = "UNIMAC";
				phy-handle = <&phy_lan0>;
				phy-mode = "gmii";
				label = "lan0";
				status = "okay";
			};

			port@1 {
				reg = <1>;
				mac-type = "UNIMAC";
				phy-handle = <&phy_lan1>;
				phy-mode = "gmii";
				label = "lan1";
				status = "okay";
			};

			port@2 {
				reg = <2>;
				mac-type = "UNIMAC";
				phy-handle = <&phy_lan2>;
				phy-mode = "gmii";
				label = "lan2";
				status = "okay";
			};

			port@3 {
				reg = <3>;
				mac-type = "UNIMAC";
				phy-handle = <&phy_lan3>;
				phy-mode = "gmii";
				label = "lan3";
				status = "okay";
			};

			port@5 {
				reg = <5>;
				mac-type = "UNIMAC";
				phy-handle = <&phy_lan4>;
				phy-mode = "hsgmii";
				label = "lan4";
				status = "okay";
			};

			/*
			 * reg 6 = PON/XFI WAN。首轮 probe 先关掉：PON PHY 驱动
			 * （phy_drv_pon）要到 init_post 才注册，而端口解析发生在
			 * init_post 之前，找不到 PHY 会让整次 probe 提前失败。
			 * 等 LAN 路径跑通再单独打开。
			 */
			port@6 {
				reg = <6>;
				phy-mode = "xfi";
				detect;
				is-wan;
				label = "wan0";
				status = "disabled";
			};
		};
	};
};

/* 串口：上游默认 disabled */
&uart0 {
	status = "okay";
};

/* NAND 控制器：上游默认 disabled */
&nand_controller {
	brcm,wp-not-connected;
	status = "okay";
};

/* NAND 片选：分区挂在这里 */
&nandcs {
	nand-on-flash-bbt;
	brcm,nand-ecc-use-strap;

	partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* 厂商 loader（SPL+TPL+U-Boot 2019.07），只读，勿写 */
			loader@0 {
				label = "loader";
				reg = <0x00000000 0x00200000>;
				read-only;
			};

			/* 主镜像区：原厂为 UBI（bootfs1/rootfs1/bootfs2/rootfs2/felix1/felix2） */
			image@200000 {
				label = "image";
				reg = <0x00200000 0x0a400000>;
			};

			/* 厂商 IPG 区，本固件不使用 */
			ipg@a600000 {
				label = "ipg";
				reg = <0x0a600000 0x05700000>;
				read-only;
			};

			/* 出厂数据：光学校准、SN、MAC 等 */
			factory@fd00000 {
				label = "factory";
				reg = <0x0fd00000 0x00200000>;
				read-only;
			};
		};
};
