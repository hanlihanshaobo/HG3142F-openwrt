# FiberHome HG3142F (BCM96855) 网络配置
#
# 当前阶段：只有 PCIe 上的 RTL8125(10ec:8125) 2.5G 网口可用，作为 LAN。
# BCM 交换芯片的 4 个千兆 LAN 口还没有驱动（需移植 bcm_enet），
# 等驱动就绪后把 lan1..lan4 加进 br-lan 的 ports 即可。
#
# 2.5G 口自协商：对端是千兆网卡时跑 1Gbps，对端支持 2.5G 时跑 2500Mbps。

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option ula_prefix 'fd3a:8f21:5c07::/48'

# RTL8125 内部没有烧录 MAC（r8169 每次启动都会 "can't read MAC address" 并随机生成），
# 必须由系统提供一个稳定值，否则 DHCP 租约每次都变。
#
# 这里**不写死 MAC**：同一个型号装到不同设备上会全部撞车，DHCP 会互相打架。
# 具体值由 /etc/uci-defaults/97-mb4784w-mac 在首次启动时生成并落盘
# （首字节固定 02 = 本地管理地址），之后每次启动复用。
config device
	option name 'eth0'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.1.1/24'
	option ip6assign '60'
